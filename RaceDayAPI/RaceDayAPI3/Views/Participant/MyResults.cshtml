@model IEnumerable<RaceDayAPI3.Models.ResultViewModel>
@{
    ViewData["Title"] = "My Race Results";
}

<div class="container py-4">
    <div class="mb-4">
        <h2 class="fw-bold text-dark mb-1"><i class="bi bi-trophy me-2 text-warning"></i>My Race Results & History</h2>
        <p class="text-muted mb-0">Review your official finish times and rankings across completed events.</p>
    </div>

    @if (Model == null || !Model.Any())
    {
        <div class="card text-center py-5">
            <div class="card-body">
                <i class="bi bi-award display-4 text-muted mb-3"></i>
                <h5 class="fw-bold text-secondary">No Results Recorded Yet</h5>
                <p class="text-muted">Your completed race results will appear here once published by the organiser.</p>
            </div>
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm overflow-hidden">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th class="py-3 ps-4">Event Name</th>
                            <th class="py-3">Date</th>
                            <th class="py-3">Category</th>
                            <th class="py-3">Finish Time</th>
                            <th class="py-3 pe-4">Position / Ranking</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var res in Model)
                        {
                            <tr>
                                <td class="ps-4 fw-bold text-dark">@res.EventTitle</td>
                                <td class="text-muted">@res.EventDate.ToString("dd MMM yyyy")</td>
                                <td><span class="badge bg-light text-dark border">@res.CategoryName</span></td>
                                <td class="font-monospace fw-semibold text-primary">@res.FinishTime</td>
                                <td class="pe-4">
                                    <span class="badge bg-success bg-opacity-10 text-success border border-success px-3 py-2 fw-bold">
                                        <i class="bi bi-award-fill me-1"></i> @res.Position out of @res.TotalParticipants finishers
                                    </span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>