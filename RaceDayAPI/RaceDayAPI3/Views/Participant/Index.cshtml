@model IEnumerable<RaceDayAPI3.Models.EventViewModel>
@{
    ViewData["Title"] = "Upcoming Events";
}

<div class="mb-4">
    <h2 class="fw-bold text-dark">Upcoming Events</h2>
    <p class="text-muted">Find and enrol in premier sporting events across South Africa.</p>
</div>

<div class="row g-4">
    @if (Model == null || !Model.Any())
    {
        <div class="col-12 text-center py-5">
            <div class="p-5 bg-light rounded-3 shadow-sm">
                <h4 class="fw-bold text-muted">No upcoming events found</h4>
                <p class="text-secondary mb-0">Check back later for newly scheduled races!</p>
            </div>
        </div>
    }
    else
    {
        @foreach (var item in Model)
        {
            <div class="col-md-4">
                <div class="card h-100 border-0 shadow-sm rounded-3 overflow-hidden">
                    @if (!string.IsNullOrEmpty(item.BannerImageUrl))
                    {
                        <img src="@item.BannerImageUrl" class="card-img-top" style="height: 180px; object-fit: cover;" alt="@item.Name">
                    }
                    else
                    {
                        <div class="bg-dark text-warning d-flex align-items-center justify-content-center" style="height: 180px;">
                            <span class="fw-bold fs-4">RACE<span class="text-white">DAY</span></span>
                        </div>
                    }
                    <div class="card-body d-flex flex-column">
                        <div class="d-flex justify-content-between mb-2">
                            <span class="badge bg-warning text-dark fw-bold">@item.Type</span>
                            <small class="text-muted fw-bold">@item.Date.ToString("MMM dd, yyyy")</small>
                        </div>
                        <h5 class="card-title fw-bold text-dark">@item.Name</h5>
                        <p class="card-text text-muted small">@item.Location | @item.Distance km</p>
                        <div class="mt-auto pt-3 border-top d-flex justify-content-between align-items-center">
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-dark w-100 fw-bold">View Details & Enrol</a>
                        </div>
                    </div>
                </div>
            </div>
        }
    }
</div>